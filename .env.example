# Este es nomas para saber que poner el .env de cada uno, tienen que crear otro en su propia version con sus datos

SECRET_KEY=cadena-larga-random-de-caracteres
FLASK_DEBUG=0
PORT=8000

# MySQL (lo usan el contenedor db y la app)
MYSQL_ROOT_PASSWORD=root_cambiar
MYSQL_DATABASE=memorama
MYSQL_USER=memorama
MYSQL_PASSWORD=memorama_cambiar
# Puerto de MySQL en tu pc (docker-compose.yml de desarrollo)
MYSQL_HOST_PORT=3307

# Solo si corres Flask fuera de Docker necesitaras la linea d abajo. Sin DATABASE_URL se usa SQLite local.
# DATABASE_URL=mysql+pymysql://memorama:memorama_cambiar@localhost:3307/memorama
